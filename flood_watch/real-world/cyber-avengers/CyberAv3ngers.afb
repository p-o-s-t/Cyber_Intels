e_id","T1565.001"],["technique_ref","attack-pattern--1cfcb312-b8d7-47a4-b560-4b16cc677292"],["description","The actors erased the original ladder logic file on the device and downloaded their own. Their ladder logic file contained no inputs or outputs. Since the programmed ladder logic is responsible for directing the functioning of the device, the replacement ladder logic file prevented the compromised devices from operating as intended."],["confidence",null],["execution_start",null],["execution_end",null]]},{"id":"a8426ef5-03bf-49e5-b1db-2022727f221b","x":460,"y":1570,"attrs":256,"template":"note","children":["6034670d-82e6-4b65-94f4-84819d70f3f2","3b299d44-3726-44f8-a300-7f2545e4aeed","e8da0eeb-f38f-4b31-b364-efbcd3063a45","805e2b85-c8ea-4e7a-9aaf-0bdee1ac0a63","bc05653f-40b3-4dec-985c-96af98b2b536","1f4d18d9-232a-4481-bba4-221087f54e7c","b1f8f06d-bf0f-40d3-86e8-34092852df82","c9701609-71e8-401f-b23a-f6a47853a97f","0f2c9397-6b82-49d1-a791-6fb4e760e723","07925e75-6312-401e-8119-499c97c55734","cca2ebe8-0823-47ef-8a38-104dfa789e41","76820708-2fb9-4822-b0a9-1d5e06c922d1"],"properties":[["abstract","Default Password"],["content","1111"],["authors",[]]]},{"id":"01d0148f-9731-4e3d-9ddc-4d073a9522c3","x":275,"y":1570,"attrs":0,"template":"@__builtin__line_horizontal_elbow","children":["e3541da8-6dc2-4667-9353-e223dc36de8b","54f8066d-bf73-4ee6-aca9-2c71a4262047","b65f7d42-185f-44a6-9f64-593716de66fb"],"properties":[]},{"id":"b9a2e468-db64-47d7-8a27-8bd9122b346e","x":560,"y":1030,"attrs":256,"template":"note","children":["3c1398b4-9eaf-47d1-a290-8bfb00069e23","503aca3e-3fb4-47bf-b207-a16575025952","ea4aceba-7212-4503-a58b-a2bacdddbc34","2a1c517e-3f9c-43cb-a993-b299765fa491","83f271af-fb16-4e2b-81cf-ca856735dd79","b2981759-d5d5-42d9-8bd1-82e86b55d46f","c6bd6b0d-59c5-4576-9cab-d20d1661330c","433ea09c-0f2d-468a-b79c-af02089bd824","7bcbe6df-6b73-49d8-beb4-fed023c4ebe0","8c9cdb9b-c33e-421b-a8a7-805bf226e297","f5e93bda-c4ad-4eb7-b941-9945e7b156d1","8866a5c4-0875-47e8-82af-3e638b114fb9"],"properties":[["abstract","TCP Port 20256"],["content","Cyber actors are actively targeting TCP 20256 after identifying it through network probing as a port associated to Unitronics PLC. Once identified, they leverage scripts specific to PCOM/TCP to query and validate the system, allowing for further probing and connection. If available, use PCOM/TCP filters to parse out the packets."],["authors",[]]]},{"id":"8c633d3a-1df7-4ec7-b219-ce9fd1c27e58","x":284,"y":1030,"attrs":0,"template":"@__builtin__line_horizontal_elbow","children":["b0b9fd9a-2ba3-43a3-9e26-f6cd22361a4c","bfdb9138-95b8-4fa0-be8e-57737d454a9d","66eaf982-e571-4355-b8c7-199f32f0781c"],"properties":[]},{"id":"5afa169c-04a5-4f14-80d0-5cf4e66e83cf","x":-230,"y":2660,"attrs":256,"template":"action","children":["15f52686-6632-40b8-a01c-30d393c6fc52","21100c96-cf1c-4041-b5d8-ccbdcf91f41a","5b1d7889-07a1-4d99-85fc-05317973503f","3f621ce0-78eb-4f74-9ad8-260d43644379","75b255b7-f3ef-488a-be07-7e0befbc0fac","508d9524-d338-46db-b319-5a483dea26c7","5c129ab4-534d-4fe9-b7fa-262353494406","b60be02f-6f2c-49d6-83e5-2cfb70718457","cb4b3c72-b6a7-4182-9f87-1129ae13d5e8","53e4dcf4-9224-4351-8c54-fdcc476ae355","a4343d67-700d-4bf0-bcaf-be420e0a396e","83b57235-26a8-4fe3-8be5-94582587d5fe"],"properties":[["name","Account Access Removal"],["tactic_id","TA0040"],["tactic_ref","x-mitre-tactic--5569339b-94c2-49ee-afb3-2222936582c8"],["technique_id","T1531"],["technique_ref","attack-pattern--b24e2a20-3b3d-4bf0-823b-1ed765398fb0"],["description","The actors renamed the compromised devices, which delayed the device operators from accessing\nthe devices remotely as the device name was a required field for facilitating remote connections"],["confidence",null],["execution_start",null],["execution_end",null]]},{"id":"a5f4d602-8c26-435c-9efc-071bc72567bd","x":-133,"y":2434,"attrs":0,"template":"@__builtin__line_vertical_elbow","children":["9fbd2beb-ce02-48ae-8e23-d944789e59e5","45c900f1-279f-4f54-9c98-14265091e76c","08f48783-b9e9-4